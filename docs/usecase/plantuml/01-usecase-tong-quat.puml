@startuml
title LƯỢC ĐỒ USE CASE TỔNG HỢP THEO 13 LUỒNG NGHIỆP VỤ CHÍNH

left to right direction
scale max 1500*900

skinparam dpi 120
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam nodesep 42
skinparam ranksep 48
skinparam padding 6
skinparam wrapWidth 170

skinparam usecase {
    BackgroundColor #F8FAFC
    BorderColor #64748B
    ArrowColor #64748B
    FontColor #1E293B
    FontSize 11
}

skinparam actor {
    BorderColor #334155
    FontColor #334155
    FontSize 11
}

actor "Khách\nvãng lai" as Guest
actor "Khách hàng" as Customer
actor "Huấn luyện\nviên" as Coach
actor "Nhân viên\nchi nhánh" as Employee
actor "Quản lý\nchi nhánh" as Manager
actor "Quản trị viên" as Admin

actor "VNPay" as VNPay <<external>>
actor "GHN" as GHN <<external>>
actor "AI service" as AiService <<external>>

rectangle "HỆ THỐNG B-HUB" as System {
    package "Nền tảng và vận hành" {
        usecase "UC01\nTài khoản, xác thực\nvà phân quyền" as UC01
        usecase "UC02\nQuản lý chi nhánh,\nsân và bảng giá" as UC02
        usecase "UC11\nNhân sự\nvà ca làm" as UC11
    }

    package "Đặt sân và thanh toán" {
        usecase "UC03\nĐặt sân online" as UC03
        usecase "UC04\nVận hành tại quầy\nvà booking offline" as UC04
        usecase "UC07\nThanh toán\nvà ví" as UC07
        usecase "UC10\nKhuyến mãi" as UC10
    }

    package "Thương mại và chuỗi cung ứng" {
        usecase "UC05\nThương mại\nđiện tử" as UC05
        usecase "UC06\nQuản trị sản phẩm,\ndanh mục và media" as UC06
        usecase "UC08\nVận chuyển và\ntheo dõi đơn hàng" as UC08
        usecase "UC09\nTồn kho, nhập hàng\nvà nhà cung cấp" as UC09
    }

    package "Cộng đồng và thông minh" {
        usecase "UC12\nCộng đồng, huấn luyện viên\nvà lớp học" as UC12
        usecase "UC13\nChat, realtime, AI\nvà báo cáo thống kê" as UC13
    }
}

Guest -- UC01

Customer -- UC01
Customer -- UC03
Customer -- UC05
Customer -- UC07
Customer -- UC08
Customer -- UC12
Customer -- UC13

Coach -- UC01
Coach -- UC12
Coach -- UC13

Employee -- UC04
Employee -- UC08
Employee -- UC11
Employee -- UC13

Manager -- UC02
Manager -- UC06
Manager -- UC09
Manager -- UC11
Manager -- UC13

Admin -- UC01
Admin -- UC02
Admin -- UC06
Admin -- UC07
Admin -- UC09
Admin -- UC10
Admin -- UC11
Admin -- UC12
Admin -- UC13

UC03 ..> UC07 : <<include>>
UC03 ..> UC10 : <<include>>
UC04 ..> UC07 : <<include>>
UC04 ..> UC11 : <<include>>
UC05 ..> UC07 : <<include>>
UC05 ..> UC08 : <<include>>
UC05 ..> UC09 : <<include>>
UC05 ..> UC10 : <<include>>

UC07 -- VNPay
UC08 -- GHN
UC13 -- AiService

@enduml
